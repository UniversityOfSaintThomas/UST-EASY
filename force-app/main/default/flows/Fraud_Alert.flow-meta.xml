        </rules>
    </decisions>
    <decisions>
        <name>Review_Status_Currently_Blank</name>
        <label>Review Status Currently Blank?</label>
        <locationX>176</locationX>
        <locationY>816</locationY>
        <defaultConnector>
            <targetReference>Has_Alert_Recipients</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Already Set - Leave As Is</defaultConnectorLabel>
        <rules>
            <name>Is_Blank</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Application.Fraud_Review_Status__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Fraud_Review_Status</targetReference>
            </connector>
            <label>Is Blank</label>
        </rules>
    </decisions>
    <formulas>
        <name>ReCAPTCHA_Below_Threshold</name>
        <dataType>Boolean</dataType>
        <expression>TEXT({!$Record.ReCAPTCHA_Score_Status__c}) = &quot;Scored&quot; &amp;&amp; NOT(ISBLANK({!Get_Settings.reCAPTCHA_v3_Score__c})) &amp;&amp; {!$Record.ReCAPTCHA_Score__c} &lt; {!Get_Settings.reCAPTCHA_v3_Score__c}</expression>
    </formulas>
    <formulas>
        <name>Applicant_Has_Mailing_Address</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISBLANK({!Get_Application.Contact__r.MailingCity})) &amp;&amp; NOT(ISBLANK({!Get_Application.Contact__r.MailingCountry}))</expression>
    </formulas>
    <formulas>
        <name>Location_Appears_To_Match</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISBLANK({!$Record.Geolocation__c})) &amp;&amp;
(
(NOT(ISBLANK({!Get_Application.Contact__r.MailingCity})) &amp;&amp; CONTAINS(UPPER({!$Record.Geolocation__c}), UPPER({!Get_Application.Contact__r.MailingCity}))) ||
(NOT(ISBLANK({!Get_Application.Contact__r.MailingState})) &amp;&amp; CONTAINS(UPPER({!$Record.Geolocation__c}), UPPER({!Get_Application.Contact__r.MailingState}))) ||
(NOT(ISBLANK({!Get_Application.Contact__r.MailingCountry})) &amp;&amp; CONTAINS(UPPER({!$Record.Geolocation__c}), UPPER({!Get_Application.Contact__r.MailingCountry})))
)</expression>
    </formulas>
    <formulas>
        <name>Location_Match_Warning_Tripped</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISBLANK({!$Record.Geolocation__c})) &amp;&amp; {!Applicant_Has_Mailing_Address} &amp;&amp; NOT({!Location_Appears_To_Match})</expression>
    </formulas>
    <formulas>
        <name>Alert_Email_Subject</name>
        <dataType>String</dataType>
        <expression>&quot;Fraud Review Recommended: Application &quot; &amp; {!Get_Application.Name}</expression>
    </formulas>
    <formulas>
        <name>Alert_Email_Body</name>
        <dataType>String</dataType>
        <expression>&quot;A submission event on Application &quot; &amp; {!Get_Application.Name} &amp; &quot; (Contact: &quot; &amp; {!Get_Application.Contact__r.FirstName} &amp; &quot; &quot; &amp; {!Get_Application.Contact__r.LastName} &amp; &quot;) tripped one or more fraud monitoring signals and is recommended for review.&quot; &amp; BR() &amp; BR() &amp;
&quot;reCAPTCHA Score: &quot; &amp; TEXT({!$Record.ReCAPTCHA_Score__c}) &amp; &quot; (Status: &quot; &amp; TEXT({!$Record.ReCAPTCHA_Score_Status__c}) &amp; &quot;)&quot; &amp; BR() &amp;
&quot;Shared IP Warning: &quot; &amp; IF({!Sharing_IP_Warning_Result}, &quot;Yes&quot;, &quot;No&quot;) &amp; &quot; (&quot; &amp; TEXT({!Get_Application.Shared_IP_User_Count_30Day__c}) &amp; &quot; distinct applicants sharing this IP in the last 30 days)&quot; &amp; BR() &amp;
&quot;IP Location Match Warning: &quot; &amp; IF({!Location_Match_Warning_Tripped}, &quot;Yes&quot;, &quot;No&quot;) &amp; &quot; (Submission IP Location: &quot; &amp; {!$Record.Geolocation__c} &amp; &quot; | Mailing Address: &quot; &amp; {!Get_Application.Contact__r.MailingCity} &amp; &quot;, &quot; &amp; {!Get_Application.Contact__r.MailingState} &amp; &quot;, &quot; &amp; {!Get_Application.Contact__r.MailingCountry} &amp; &quot;)&quot; &amp; BR() &amp; BR() &amp;
&quot;This is a monitoring signal only. It does not indicate confirmed fraud and does not block or deny the application. Please review the application record and related Application Login records before taking any action.&quot;</expression>
    </formulas>
    <formulas>
        <name>Fault_Email_Subject_PreLookup</name>
        <dataType>String</dataType>
        <expression>&quot;Fraud Alert Flow Error: Could not evaluate Application_Login__c record &quot; &amp; {!$Record.Id}</expression>
    </formulas>
    <formulas>
        <name>Fault_Email_Body_PreLookup</name>
        <dataType>String</dataType>
        <expression>&quot;The Fraud Alert Flow encountered an error before it could load the related Application or Application Setting record, so no fraud signals were evaluated for this submission event.&quot; &amp; BR() &amp; BR() &amp;
&quot;Application_Login__c record: &quot; &amp; {!$Record.Id} &amp; BR() &amp;
&quot;Application__c (attempted): &quot; &amp; {!$Record.Application__c} &amp; BR() &amp; BR() &amp;
&quot;Error detail: &quot; &amp; {!$Flow.FaultMessage} &amp; BR() &amp; BR() &amp;
&quot;Please review this application manually - the automated fraud check did not run for this submission.&quot;</expression>
    </formulas>
    <formulas>
        <name>Fault_Email_Subject_PostLookup</name>
        <dataType>String</dataType>
        <expression>&quot;Fraud Alert Flow Error: Application &quot; &amp; {!Get_Application.Name}</expression>
    </formulas>
    <formulas>
        <name>Fault_Email_Body_PostLookup</name>
        <dataType>String</dataType>
        <expression>&quot;The Fraud Alert Flow encountered an error while processing a submission event for Application &quot; &amp; {!Get_Application.Name} &amp; &quot; (Contact: &quot; &amp; {!Get_Application.Contact__r.FirstName} &amp; &quot; &quot; &amp; {!Get_Application.Contact__r.LastName} &amp; &quot;).&quot; &amp; BR() &amp; BR() &amp;
&quot;Error detail: &quot; &amp; {!$Flow.FaultMessage} &amp; BR() &amp; BR() &amp;
&quot;The fraud-signal evaluation for this submission may be incomplete. Please review this application manually.&quot;</expression>
    </formulas>
    <interviewLabel>Fraud Alert {!$Flow.CurrentDateTime}</interviewLabel>
