    <decisions>
        <name>Meets_Shared_IP_Threshold</name>
        <label>Meets Shared IP Threshold?</label>
        <locationX>440</locationX>
        <locationY>396</locationY>
        <defaultConnector>
            <targetReference>Any_Fraud_Signal_Tripped</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Below Threshold or Not Configured</defaultConnectorLabel>
        <rules>
            <name>Meets_Threshold</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Settings.Shared_IP_Count_Warning_Threshold__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Application.Shared_IP_User_Count_30Day__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>Get_Settings.Shared_IP_Count_Warning_Threshold__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Shared_IP_Warning_True</targetReference>
            </connector>
            <label>Meets Threshold</label>
        </rules>
    </decisions>
    <decisions>
        <name>Any_Fraud_Signal_Tripped</name>
        <label>Any Fraud Signal Tripped?</label>
        <locationX>176</locationX>
        <locationY>696</locationY>
        <defaultConnectorLabel>No Signals Tripped - End</defaultConnectorLabel>
        <rules>
            <name>Signal_Tripped</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Sharing_IP_Warning_Result</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Location_Match_Warning_Tripped</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>ReCAPTCHA_Below_Threshold</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Review_Status_Currently_Blank</targetReference>
            </connector>
            <label>Signal Tripped</label>
        </rules>
    </decisions>
    <decisions>
        <name>Has_Alert_Recipients</name>
